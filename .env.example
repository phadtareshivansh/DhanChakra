# Dhan-Chakra Environment Variables
# Copy to .env and adjust as needed. Never commit the real .env.
# Values below are placeholders — replace every "change-me" before deploying.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Container resource tuning (optional; used by docker-compose)
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dhanchakra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dhanchakra

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Deployment environment: development | staging | production
# In production the API refuses to boot with placeholder secrets (JWT_SECRET
# must be >= 32 chars) and skips demo-user seeding.
APP_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Maximum page size accepted by paginated endpoints
MAX_PAGE_SIZE=100
# Default page size when the caller does not specify one
DEFAULT_PAGE_SIZE=20

# --- Auth (REQUIRED: no default) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Demo users (optional; seeded at API startup when enabled) ---
# Seeding is idempotent (ON CONFLICT DO NOTHING) and ignored in production
# unless ALLOW_DEMO_SEED=true.
SEED_DEMO_USERS=false
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME="Demo Admin"
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=
DEMO_ANALYST_NAME="Demo Analyst"

# --- Heuristic risk scoring weights / caps / threshold ---
RISK_CYCLE_BASE=40
RISK_CYCLE_STEP=5
RISK_CYCLE_CAP=20
RISK_DIRECTOR_WEIGHT=5
RISK_DIRECTOR_CAP=15
RISK_ADDRESS_WEIGHT=4
RISK_ADDRESS_CAP=10
RISK_DEGREE_WEIGHT=2
RISK_DEGREE_CAP=10
RISK_PAGERANK_WEIGHT=150
RISK_PAGERANK_CAP=15
RISK_BETWEENNESS_WEIGHT=100
RISK_BETWEENNESS_CAP=10
# Minimum distinct counterparties before the degree term contributes
RISK_DEGREE_MIN=2
# Heuristic score is clamped to this maximum
RISK_SCORE_CAP=100.0
# Companies at/above this score are flagged as risky
RISK_FLAG_THRESHOLD=40

# --- Graph analytics ---
# Maximum invoice hops considered when detecting circular-trading rings
MAX_CYCLE_HOPS=8
# Minimum number of distinct companies that constitute a ring
MIN_CYCLE_LENGTH=3
# Network view: allowed hop range and fallback
MAX_NEIGHBORHOOD_HOPS=5
DEFAULT_NEIGHBORHOOD_HOPS=2
LOOPS_DEFAULT_MAX_LENGTH=6
WEAK_LABEL_THRESHOLD=40
# Jaro-Winkler name-similarity cut-off for fuzzy entity resolution
ENTITY_RESOLUTION_FUZZY_THRESHOLD=0.92
# Jaro-Winkler internals: longest common prefix considered, and its weight
ENTITY_RESOLUTION_PREFIX_MAX=4
ENTITY_RESOLUTION_PREFIX_SCALE=0.1

# --- Query result guards (defensive caps on path-enumeration queries) ---
# Max rings returned when flagging cycle edges for an entity
MAX_RING_PATHS=50
# Max loops for a single entity / for the whole graph
MAX_ENTITY_LOOP_PATHS=50
MAX_GLOBAL_LOOP_PATHS=100
# Max distinct cycles materialised per structural analytics run
MAX_CYCLE_PATHS=1000
# Max audit-log rows returned by /audit
AUDIT_LOG_MAX_LIMIT=100

# --- GDS (Neo4j Graph Data Science) ---
# Name of the in-memory invoice projection; Louvain iteration cap
GDS_PROJECTION_NAME=company_invoice_graph
GDS_LOUVAIN_MAX_ITERATIONS=20

# --- GNN training defaults ---
GNN_DEFAULT_EPOCHS=60
GNN_FINETUNE_EPOCHS=120
GNN_BENCHMARK_GRAPHS=40
# Sigmoid score at/above which a node is predicted positive
GNN_DECISION_THRESHOLD=0.5
GNN_CHECKPOINT_DIR=/app/models
GNN_CHECKPOINT_FILENAME=gnn_risk_v1.pt
GNN_METRICS_FILENAME=gnn_metrics.json
# GNN_CHECKPOINT_PATH=   # optional: overrides DIR/FILENAME when set

# --- Agentic ingestion (MCA filing extraction) ---
# Backend: "rules" (offline, default) or "llm" (requires AGENT_LLM_URL+KEY)
AGENT_INGEST_BACKEND=rules
AGENT_INGEST_CONFIDENCE=0.8
# Max characters of filing text sent to the LLM backend
AGENT_LLM_MAX_CHARS=4000
# AGENT_LLM_URL=
# AGENT_LLM_KEY=
AGENT_LLM_MODEL=llama-3-70b

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_PROXY_TARGET=http://api:8000
VITE_HOST=0.0.0.0
VITE_PORT=5173
# Risk badge bands
VITE_RISK_CRITICAL_THRESHOLD=85
VITE_RISK_HIGH_THRESHOLD=65
VITE_RISK_MEDIUM_THRESHOLD=40
# Free-text hint shown on the login page (leave empty to hide)
VITE_DEMO_HINT=
